<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared links are tried over https first. Some sites still only serve plain http, so allow
    it as a fallback for reading their pages.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
